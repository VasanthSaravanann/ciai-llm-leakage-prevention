# Staging / deployment example
API_KEY=staging-key-1
API_KEYS=staging-key-1,staging-key-2
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/caiai_audit
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-random-secret
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-real-staging-llm-key
OPENAI_MODEL=gpt-4o-mini
ENCRYPT_LOGS=1
KMS_KEY_ID=
RETENTION_DAYS=90
MAX_REQUEST_SIZE=100000
MAX_B64_RECURSION=3
# Example environment variables for CIAI
API_KEY=your-api-key-here
DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/ciai_audit
MAX_REQUEST_SIZE=100000
MAX_B64_RECURSION=3
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=supersecret
PRESIDIO_MODEL=en_core_web_sm
# AWS KMS key ID for envelope encryption (optional)
KMS_KEY_ID=arn:aws:kms:region:account:key/abcd-1234# CIAI – LLM Data Leakage Prevention
# Environment Configuration Template
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# API Authentication (VULN-004)
# ---------------------------------------------------------------------------
# Set a strong API key to protect /detect and /log endpoints
# Leave empty to disable auth (dev mode only — NOT for production)

API_KEY=your-secret-api-key-here

# ---------------------------------------------------------------------------
# SMTP Email Alerts (Phase 2)
# ---------------------------------------------------------------------------
# For Gmail: enable 2FA and use an App Password
# https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=your_email@gmail.com
ALERT_EMAIL=security@yourcompany.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: SQLite in ./data/ciai_audit.db
# Override for PostgreSQL, MySQL, etc.

DATABASE_URL=sqlite+aiosqlite:///./data/ciai_audit.db
