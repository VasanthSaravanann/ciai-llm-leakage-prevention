# Database Configuration
DATABASE_URL=postgresql+psycopg://ciai_user:your_strong_password_here@postgres:5432/ciai
DB_USER=ciai_user
DB_PASSWORD=your_strong_password_here
DB_NAME=ciai
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://:your_redis_password@redis:6379
REDIS_PASSWORD=your_redis_password

# API Configuration
API_KEY=your_api_key_here_minimum_32_chars_required
API_PORT=8000
WORKERS=4

# Security & Auth
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
OIDC_PROVIDER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
AUTH_MODE=api_key  # Options: api_key, jwt, oidc

# Encryption
ENCRYPTION_KEY=your_fernet_key_base64_encoded
KMS_KEY_ID=arn:aws:kms:region:account:key/id  # For AWS KMS
USE_KMS=false

# Logging & Monitoring
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED=true

# Detection Configuration
DETECTION_ENGINE=presidio  # Options: presidio, custom
SPACY_MODEL=en_core_web_sm
DETECTION_FAIL_CLOSED=true
DETECTION_TIMEOUT_SECONDS=5

# Moderation (Output-side)
ENABLE_OUTPUT_MODERATION=true
MODERATION_PII_DETECTION=true
MODERATION_SECRETS_DETECTION=true

# Email Alerts
ENABLE_EMAIL_ALERTS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=alerts@your-domain.com
ALERT_EMAIL_TO=security-team@your-domain.com
ALERT_THRESHOLD=5  # Alert after N sensitive detections

# AWS Configuration (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Tenant/Organization
TENANT_ID=default_tenant
ORGANIZATION_ID=your_org

# Gateway Behavior
GATEWAY_MODE=fail_closed  # Options: fail_open, fail_closed
ENABLE_TENANT_ISOLATION=true

# Feature Flags
FEATURE_OIDC=false
FEATURE_RBAC=false
FEATURE_CUSTOM_POLICIES=false
FEATURE_ADVANCED_ENCRYPTION=false

# Environment
ENVIRONMENT=enterprise
DEBUG=false
